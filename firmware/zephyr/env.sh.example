# source this to build with the local Zephyr workspace
. "$HOME/zephyr-work/venv/bin/activate"
export ZEPHYR_BASE="$HOME/zephyr-work/ws/zephyr"
export ZEPHYR_SDK_INSTALL_DIR="$HOME/zephyr-work/zephyr-sdk"
export ZEPHYR_TOOLCHAIN_VARIANT=zephyr
export PATH="$ZEPHYR_SDK_INSTALL_DIR/hosttools/sysroots/x86_64-pokysdk-linux/usr/bin:$PATH"
cd "$HOME/zephyr-work/ws"   # the west workspace containing zephyr/ and modules/
